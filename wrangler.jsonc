{
  // The name must match the "Project name" you typed in Cloudflare.
  "name": "yaktonian-equity",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sitemap.xml", "/robots.txt", "/articles/*"]
  },
  // Existing KV namespace "yaktonian-equity-yq" (pinned so deploys do not try to recreate it).
  "kv_namespaces": [{ "binding": "YQ", "id": "9ad3fdbcb7f44789a51585dd8d2cb40e" }]
}
